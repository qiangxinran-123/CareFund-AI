{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carefund.ai/contracts/schemas/application.schema.json",
  "title": "CareFund Application Contract V1",
  "$ref": "#/$defs/ApplicationResponse",
  "$defs": {
    "ApplicationStatus": {
      "type": "string",
      "enum": [
        "collecting",
        "reviewing",
        "ready_for_draft",
        "draft_ready",
        "confirmed",
        "exported"
      ],
      "description": "Backend-owned state. Clients and agents cannot transition it directly."
    },
    "PatientInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "medical_summary"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "age_group": {
          "type": ["string", "null"],
          "enum": ["child", "adult", "older_adult", "unknown", null],
          "description": "null means not supplied; clients must not infer age."
        },
        "medical_summary": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000,
          "description": "User-provided summary, not a diagnosis. null means not supplied."
        }
      }
    },
    "PatientInfoPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "age_group": {
          "type": ["string", "null"],
          "enum": ["child", "adult", "older_adult", "unknown", null]
        },
        "medical_summary": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "description": "Partial patient information update. Omitted properties remain unchanged; null explicitly clears an allowed nullable value."
    },
    "FinancialInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paid_cost", "estimated_cost", "funding_target"],
      "properties": {
        "paid_cost": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/Money"}, {"type": "null"}],
          "description": "Medical costs already paid, as entered by the user."
        },
        "estimated_cost": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/Money"}, {"type": "null"}],
          "description": "Estimated future treatment cost, as entered by the user."
        },
        "funding_target": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/Money"}, {"type": "null"}],
          "description": "User-entered fundraising target; the system must not infer it from other amounts."
        }
      }
    },
    "FinancialInfoPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "paid_cost": {"oneOf": [{"$ref": "common.schema.json#/$defs/Money"}, {"type": "null"}]},
        "estimated_cost": {"oneOf": [{"$ref": "common.schema.json#/$defs/Money"}, {"type": "null"}]},
        "funding_target": {"oneOf": [{"$ref": "common.schema.json#/$defs/Money"}, {"type": "null"}]}
      },
      "description": "Partial financial information update. Omitted properties remain unchanged; null explicitly clears a value."
    },
    "Application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "schema_version",
        "revision",
        "status",
        "patient_info",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "application_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "schema_version": {"$ref": "common.schema.json#/$defs/SchemaVersion"},
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Backend-owned, monotonically increasing version of user input and the attachment set."
        },
        "status": {"$ref": "#/$defs/ApplicationStatus"},
        "patient_info": {"$ref": "#/$defs/PatientInfo"},
        "financial_info": {"$ref": "#/$defs/FinancialInfo"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "updated_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"}
      }
    },
    "CreateApplicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patient_info"],
      "properties": {
        "patient_info": {"$ref": "#/$defs/PatientInfo"},
        "financial_info": {"$ref": "#/$defs/FinancialInfo", "default": {"paid_cost": null, "estimated_cost": null, "funding_target": null}}
      }
    },
    "UpdateApplicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision"],
      "anyOf": [
        {"required": ["patient_info"]},
        {"required": ["financial_info"]}
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Optimistic concurrency token. A mismatch must return HTTP 409 STATE_CONFLICT."
        },
        "patient_info": {"$ref": "#/$defs/PatientInfoPatch"},
        "financial_info": {"$ref": "#/$defs/FinancialInfoPatch"}
      }
    },
    "ApplicationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "documents", "evidence"],
      "properties": {
        "application": {"$ref": "#/$defs/Application"},
        "documents": {
          "type": "array",
          "items": {"$ref": "evidence.schema.json#/$defs/UploadedDocument"},
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "evidence.schema.json#/$defs/Evidence"},
          "default": []
        }
      }
    }
  }
}
