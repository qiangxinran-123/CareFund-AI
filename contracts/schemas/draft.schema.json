{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carefund.ai/contracts/schemas/draft.schema.json",
  "title": "CareFund Draft Contract V1",
  "$ref": "#/$defs/Draft",
  "$defs": {
    "DraftStatus": {
      "type": "string",
      "enum": ["generated", "confirmed", "stale"]
    },
    "DraftSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "content", "fact_ids"],
      "properties": {
        "section_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "content": {"type": "string", "minLength": 1, "maxLength": 5000},
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/Identifier"},
          "uniqueItems": true,
          "description": "Every material factual statement must resolve to an existing Fact."
        }
      }
    },
    "Draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "draft_id",
        "application_id",
        "application_revision",
        "draft_revision",
        "status",
        "sections",
        "created_at"
      ],
      "properties": {
        "schema_version": {"$ref": "common.schema.json#/$defs/SchemaVersion"},
        "draft_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "application_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "application_revision": {"type": "integer", "minimum": 1},
        "draft_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonic version for drafts belonging to the same application revision."
        },
        "status": {"$ref": "#/$defs/DraftStatus"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/DraftSection"}
        },
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "confirmed_at": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/UtcDateTime"},
            {"type": "null"}
          ],
          "default": null
        }
      }
    },
    "DraftGenerationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_revision"],
      "properties": {
        "expected_revision": {"type": "integer", "minimum": 1}
      }
    },
    "DraftConfirmationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "draft_revision", "expected_application_revision"],
      "properties": {
        "draft_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "draft_revision": {"type": "integer", "minimum": 1},
        "expected_application_revision": {"type": "integer", "minimum": 1}
      },
      "description": "Backend must reject when either revision differs from the current stored values."
    },
    "ExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "draft_revision", "expected_application_revision", "format"],
      "properties": {
        "draft_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "draft_revision": {"type": "integer", "minimum": 1},
        "expected_application_revision": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "const": "json"}
      }
    },
    "ExportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_id", "application_id", "draft_id", "format", "created_at", "download_url"],
      "properties": {
        "export_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "application_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "draft_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "format": {"type": "string", "const": "json"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "download_url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "Short-lived backend URL when available; null when the JSON package is returned out of band."
        }
      }
    }
  }
}
